<launch>
    <arg name="pkg_name" default="ekf_localization" doc="name of the package"/>
    <arg name="param_file_name" default="default" doc="Specify a param file. ex:megaman." />
    <arg name="node_name" default="ekf_localization_node" doc="name of the node"/>
    <arg name="veh" doc="Name of vehicle. ex: megaman"/>

    <group ns="$(env VEHICLE_NAME)">
        <node pkg="$(arg pkg_name)" type="$(arg node_name).py" name="$(arg node_name)" output="screen"
              required="true">
              <rosparam command="load" file="$(find ekf_localization)/config/$(arg node_name)/$(arg param_file_name).yaml"/>
              <rosparam command="load" file="$(find ekf_localization)/map.yaml"/>

        </node>
    </group>

</launch>
